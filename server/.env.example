# Copy to .env (git-ignored) only if you need to change a default.
# PORT=3000                       # WebSocket gateway the board connects to (ws://<PC-IP>:3000/ws)
# STT_URL=http://127.0.0.1:8000   # speech-to-text service (server/stt-services)
# RECORDINGS_DIR=recordings       # where every command is saved (relative to where you run `npm start`)
